---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/i18n/ui";
import type { UiKey } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Locale;
  titleKey: UiKey;
}

// Temporary shared view: every route renders through it until T3 replaces
// each one with its redesigned page.
const { lang, titleKey } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={`${t(titleKey)} | ${t("site.name")}`}>
  <h1 class="pt-16 text-4xl">{t(titleKey)}</h1>
</BaseLayout>
