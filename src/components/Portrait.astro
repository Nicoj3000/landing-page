---
import { Picture } from "astro:assets";
import photo from "@/assets/images/Foto-CV.png";
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Locale;
  class?: string;
  /** Responsive `sizes` hint; defaults to the hero column. */
  sizes?: string;
}

const { lang, class: className, sizes = "(min-width: 1024px) 360px, (min-width: 640px) 320px, 70vw" } = Astro.props;
const t = useTranslations(lang);
---

<!-- Photo framed like a spec-sheet plate: crop marks + mono caption. -->
<figure class:list={["portrait relative mx-auto w-full max-w-[20rem] lg:max-w-none", className]}>
  <div class="relative bg-sunken p-2">
    <span aria-hidden="true" class="mark mark-tl"></span>
    <span aria-hidden="true" class="mark mark-tr"></span>
    <span aria-hidden="true" class="mark mark-bl"></span>
    <span aria-hidden="true" class="mark mark-br"></span>
    <Picture
      src={photo}
      alt={t("a11y.profilePicAlt")}
      formats={["avif", "webp"]}
      widths={[360, 540, 720]}
      {sizes}
      loading="eager"
      decoding="async"
      class="block h-auto w-full object-cover"
    />
  </div>
  <figcaption class="label-mono mt-3 flex justify-between gap-2">
    <span>{t("site.name")}</span>
    <span>{t("site.role")}</span>
  </figcaption>
</figure>

<style>
  .mark {
    position: absolute;
    width: 0.9rem;
    height: 0.9rem;
    border-color: var(--accent);
    border-style: solid;
    border-width: 0;
  }
  .mark-tl { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
  .mark-tr { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; }
  .mark-bl { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; }
  .mark-br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }
</style>
