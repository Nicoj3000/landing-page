---
import { DEFAULT_LOCALE, LOCALES, type Locale } from "@/i18n/ui";
import { localizedPath, stripLocale } from "@/i18n/utils";

interface Props {
  title: string;
  description: string;
  lang: Locale;
  /** Current pathname, with or without locale prefix. */
  path: string;
}

const { title, description, lang, path } = Astro.props;
const site = Astro.site ?? new URL("https://nicoj3000.netlify.app");
const neutralPath = stripLocale(path);
const absolute = (locale: Locale) => new URL(localizedPath(neutralPath, locale), site).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={absolute(lang)} />
{LOCALES.map((locale) => <link rel="alternate" hreflang={locale} href={absolute(locale)} />)}
<link rel="alternate" hreflang="x-default" href={absolute(DEFAULT_LOCALE)} />
