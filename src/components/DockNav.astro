---
import type { Locale } from "@/i18n/ui";
import type { IconName } from "@/lib/icons";
import { NAV_ITEMS } from "@/data/site";
import { localizedPath, stripLocale, useTranslations } from "@/i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const current = stripLocale(path);

const ICON_FOR: Record<string, IconName> = {
  "/": "home",
  "/about-me": "user",
  "/services": "briefcase",
  "/portfolio": "folder",
};
---

<!--
  One landmark, two presentations: a bottom tab bar below `lg` (thumb reach,
  four equal 44px+ targets, labels wrap instead of overflowing at 360px) and a
  floating top pill from `lg` up, centered between the logo and the actions.
  The bar is opaque on mobile: a backdrop blur over scrolling content is a
  paint cost on touch devices; the translucent blurred surface is desktop-only.
-->
<nav
  aria-label={t("nav.label")}
  class="dock fixed inset-x-3 bottom-3 z-50 mx-auto max-w-md lg:inset-x-0 lg:bottom-auto lg:top-5 lg:w-fit lg:max-w-none"
>
  <ul class="grid grid-cols-4 gap-1 rounded-lg border border-line-strong bg-raised p-1.5 shadow-dock lg:flex lg:items-center lg:rounded-pill lg:bg-raised/90 lg:backdrop-blur-md">
    {
      NAV_ITEMS.map(({ href, key }) => (
        <li>
          <a
            href={localizedPath(href, lang)}
            aria-current={current === href ? "page" : undefined}
            class="flex min-h-12 flex-col items-center justify-center gap-0.5 rounded-md px-1 text-center font-mono text-xs leading-tight text-muted transition-colors duration-(--duration-fast) hover:text-fg aria-[current=page]:bg-accent aria-[current=page]:text-on-accent lg:min-h-10 lg:flex-row lg:rounded-pill lg:px-4 lg:text-sm"
          >
            <Icon name={ICON_FOR[href] ?? "home"} size={18} class="lg:hidden" />
            <span>{t(key)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
