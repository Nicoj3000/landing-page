---
import { LOCALES, LOCALE_LABEL, type Locale } from "@/i18n/ui";
import { localizedPath, useTranslations } from "@/i18n/utils";

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
---

<ul class="flex items-center rounded-pill border border-line p-0.5 font-mono text-xs" aria-label={t("lang.label")}>
  {
    LOCALES.map((locale) => (
      <li>
        <a
          href={localizedPath(path, locale)}
          hreflang={locale}
          lang={locale}
          aria-label={LOCALE_LABEL[locale]}
          aria-current={locale === lang ? "true" : undefined}
          class="flex min-h-9 min-w-9 items-center justify-center rounded-pill px-2 text-muted transition-colors duration-(--duration-fast) hover:text-fg aria-[current=true]:bg-fg aria-[current=true]:text-bg"
        >
          {locale.toUpperCase()}
        </a>
      </li>
    ))
  }
</ul>
